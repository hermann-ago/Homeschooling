# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
backend/venv/
venv/
.venv/
env/

# ─── Local data ──────────────────────────────────────────────────────────────
# data/ holds the live database, backups, paired devices and migration exports.
# It must NEVER be committed.
data/
backend/tests/.tmp-data/
backend/homeschool.db
backend/*.db
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# ─── Uploaded files ──────────────────────────────────────────────────────────
# User-uploaded PDFs — not source code, can be large
backend/uploads/
!backend/uploads/.gitkeep

# ─── Environment / Secrets ───────────────────────────────────────────────────
backend/.env
.env
*.env

# ─── Node / Frontend ─────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local

# ─── IDE / OS ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini

# ─── Alembic ─────────────────────────────────────────────────────────────────
# Keep migration scripts but not compiled cache
backend/alembic/__pycache__/
backend/alembic/versions/__pycache__/
node_modules/
public/

.vercel
.env*
migration-manifest.json
migration-sql*/
migration-payload.json
