{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci --legacy-peer-deps && npm --prefix frontend run build -- --outDir ../public",
  "functions": {
    "api/[...path].py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/venv/**,backend/uploads/**,backend/**/*.sqlite,public/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!api/|assets/|favicon\\.svg$|index\\.html$).+)", "destination": "/index.html" }
  ]
}
