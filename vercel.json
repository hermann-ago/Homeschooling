{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix frontend ci --legacy-peer-deps && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/venv/**,backend/uploads/**,backend/**/*.sqlite}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!api/|assets/|favicon\\.svg$|index\\.html$).+)", "destination": "/index.html" }
  ]
}
