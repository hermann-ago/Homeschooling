# Optional. Only the Gemini key is read from the environment (backend/.env on the host).
# No Google sign-in is needed: files live in the Homeschooling folder synced by Google Drive for desktop,
# and the database is a local SQLite file under %LOCALAPPDATA%\Homeschooling.
# Set HOMESCHOOLING_DRIVE_FOLDER only if the folder is not found automatically.
GEMINI_API_KEY=
